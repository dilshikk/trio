# Email и пароль администратора панели
ADMIN_EMAIL=admin@triogroups.uz

# Хеш пароля — получить через GET /api/hash/ВАШ_ПАРОЛЬ (только без JWT_SECRET)
ADMIN_PASSWORD=salt:hash

# Секретный ключ для JWT — случайная строка 32+ символов
JWT_SECRET=замените_на_случайную_строку_минимум_32_символа

# URL фронтенда для CORS
FRONTEND_URL=https://triogroups.uz

# Порт сервера
PORT=3001

# Путь к файлу с текстами сайта (по умолчанию рядом с index.js)
# DB_PATH=/www/wwwroot/triogroups.org/server/site-texts.json
